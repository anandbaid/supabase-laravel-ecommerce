# Laravel storefront API (the /api/v1 prefix included). Server-side only —
# the browser never talks to Laravel directly.
LARAVEL_API_URL=https://your-laravel-app.onrender.com/api/v1

# Shown to admin accounts in the header menu ("Admin Panel").
NEXT_PUBLIC_ADMIN_URL=https://your-laravel-app.onrender.com/admin

# Optional: live stock on product pages via Supabase Realtime. Use the same
# project URL and *anon* key as the Laravel app (never the service key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: store name used in titles and the footer.
NEXT_PUBLIC_SITE_NAME=Let's Shop
